# Copy to a local .env that is not committed. Never put real tokens in git.
THINQ_COUNTRY=US
THINQ_LANGUAGE=en-US
THINQ_REFRESH_TOKEN=
# Optional: reuse a previously refreshed access token for a short time.
# THINQ_ACCESS_TOKEN=
# Optional: stable client id (hex). Generated automatically when omitted.
# THINQ_CLIENT_ID=
